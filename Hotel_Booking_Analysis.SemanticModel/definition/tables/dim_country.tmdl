	partition dim_country = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_country.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"country_code", type text}, {"country_name", type text}, {"continent", type text}, {"un_region", type text}, {"is_domestic", Int64.Type}, {"market", type text}}, "en-US")
				in
				    Typed

